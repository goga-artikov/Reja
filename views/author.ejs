<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://kit.fontawesome.com/6e1d1030a6.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/main.css" />
    <title>Portfolio</title>
  </head>

  <body>
    <div class="frame">
      <div class="main_frame">
        <!-- left frame -->
        <dev class="left_frame">
          <div class="left1">
            <div class="left_1-1">
              <img src="images/Profile.png" alt="profile-icon" class="left-1-img" />
              <span class="online-dot"></span>
            </div>
            <div class="left_1-2">
              <h3>Marcos</h3>
            </div>
            <div class="left_1-3">
              <p>Heart</p>
            </div>
            <div class="left-icons">
              <span class="soc-icons">
                <img src="images/Icons-facebook.svg" alt="facebook" />
              </span>
              <span class="soc-icons">
                <img src="images/Icons-instagram.svg" alt="instagram" />
              </span>
              <span class="soc-icons">
                <img src="images/Icons-twitter.svg" alt="twitter" />
              </span>
              <span class="soc-icons">
                <img src="images/Icons-linkedin.svg" alt="kinkedin" />
              </span>
              <span class="soc-icons">
                <img src="images/Icons-Youtube.svg" alt="youtube" />
              </span>
              <span class="soc-icons">
                <img src="images/Icons-dribbble.svg" alt="drible" />
              </span>
            </div>
          </div>
          <div class="marginer"></div>

          <div class="left2">
            <div class="left2-desc">
              <span class="left2-desc-info"><p>Age:</p></span>
              <p>24</p>
            </div>
            <div class="left2-desc">
              <span class="left2-desc-info"><p>Residence:</p></span>
              <p>BD</p>
            </div>
            <div class="left2-desc">
              <span class="left2-desc-info"><p>Freelance:</p></span>
              <p style="color: #7eb942">Available</p>
            </div>
            <div class="left2-desc">
              <span class="left2-desc-info"><p>Address:</p></span>
              <p>Dhaka,Bangladesh</p>
            </div>
          </div>
          <div class="marginer"></div>

          <div class="left3">
            <h4>Languages</h4>

            <div class="skill-item">
              <div class="skill-title"><span>Bangla</span><span>100%</span></div>

              <div class="progress"><div class="progress-value bangla"></div></div>
            </div>

            <div class="skill-item">
              <div class="skill-title"><span>English</span><span>80%</span></div>
              <div class="progress"><div class="progress-value english"></div></div>
            </div>

            <div class="skill-item">
              <div class="skill-title"><span>Spanish</span><span>60%</span></div>
              <div class="progress"><div class="progress-value spanish"></div></div>
            </div>
          </div>
          <div class="marginer"></div>

          <div class="left4">
            <h4>Skills</h4>

            <div class="skill-item">
              <div class="skill-title"><span>Html</span><span>90%</span></div>
              <div class="progress"><div class="progress-value html"></div></div>
            </div>

            <div class="skill-item">
              <div class="skill-title"><span>CSS</span><span>85%</span></div>
              <div class="progress"><div class="progress-value css"></div></div>
            </div>

            <div class="skill-item">
              <div class="skill-title"><span>Js</span><span>80%</span></div>
              <div class="progress"><div class="progress-value js"></div></div>
            </div>

            <div class="skill-item">
              <div class="skill-title"><span>PHP</span><span>75%</span></div>
              <div class="progress"><div class="progress-value php"></div></div>
            </div>

            <div class="skill-item">
              <div class="skill-title"><span>WordPress</span><span>85%</span></div>
              <div class="progress"><div class="progress-value wordpress"></div></div>
            </div>
          </div>

          <div class="left5">
            <h4>Extra Skills</h4>
            <ul>
              <li><img src="images/Icons.svg" alt="icon" /> Bootstrap, Materialize</li>
              <li><img src="images/Icons.svg" alt="icon" /> Stylus, Sass, Less</li>
              <li><img src="images/Icons.svg" alt="icon" /> Gulp, Webpack, Grunt</li>
              <li><img src="images/Icons.svg" alt="icon" /> GIT Knowledge</li>
            </ul>
          </div>
          <div class="marginer"></div>

          <button class="download-btn">DOWNLOAD CV <i class="fa-solid fa-download"></i></button>
        </dev>
        <!-- middle frame -->
        <dev class="midd_frame">

          <div class="container">

            <div class="main-hero">
              <div class="main-hero-desc">
                <h1>Doctor neurologists in OHSU Hospital</h1>

                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Et, volutpat feugiat placerat lobortis. Natoque rutrum semper sed suspendisse nunc lectus.</p>

                <button class="main-hero-btn">HIRE ME</button>
              </div>

              <div class="main-hero-img">
                <img src="images/YourIMAge.png" alt="hero" />
              </div>
            </div>

            <div class="my_services ">

                <div class="my_services-title">
                    <h2>My Services</h2>
                    <p>Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequat duis enim velit mollit. lorem ipsum</p>
                </div>

                <div class="my_services-cards">
                    <!-- 1 -->
                    <div class="my_services-card">
                        <div><img src="images/coding.png" alt="web"></div>
                        <h4>web development</h4>
                        <p>blog, e-commerce</p>
                    </div>
                    <!-- 2 -->
                    <div class="my_services-card">
                        <div><img src="images/illustration.png" alt="web"></div>
                        <h4>uI/uX design</h4>
                        <p>Mobile app, website design</p>
                    </div>
                    <!-- 3 -->
                    <div class="my_services-card">
                        <div><img src="images/Microphone.svg" alt="web"></div>
                        <h4>sound design</h4>
                        <p>Voice Over, Beat Making</p>
                    </div>
                    <!-- 4 -->
                    <div class="my_services-card">
                        <div><img src="images/game-development.svg" alt="web"></div>
                        <h4>game design</h4>
                        <p>Character Design, Props & Objects</p>
                    </div>
                    <!-- 5 -->
                    <div class="my_services-card">
                        <div><img src="images/photographer.svg" alt="web"></div>
                        <h4>photography</h4>
                        <p>portrait, product photography</p>
                    </div>
                    <!-- 6 -->
                    <div class="my_services-card">
                        <h4>advertising</h4>
                        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vitae nulla diam in ac dictum a urna viverra morbi. </p>
                        <a href="#">ORDER NOW</a>
                    </div>
                </div>
            </div>

          </div>
        </dev>

        <dev class="right_frame">
            <div class="contrast">
                <img src="images/Contrast.svg" alt="svg">
            </div>
            <div class="navigation">
                <!-- 1 -->
                <a href=""><img src="images/Home.svg" alt="svg"></a>
                <!-- 2 -->
                <a href=""><img src="images/Services.svg" alt="svg"></a>
                <!-- 3 -->
                <a href=""><img src="images/cv.svg" alt="svg"></a>
                <!-- 4 -->
                <a href=""><img src="images/Portfolio.svg" alt="svg"></a>
                <!-- 5 -->
                <a href=""><img src="images/Blog.svg" alt="svg"></a>
                <!-- 6 -->
                <a href=""><img src="images/Contact.svg" alt="svg"></a>
            </div>
        </dev>
      </div>
    </div>
  </body>
</html>
