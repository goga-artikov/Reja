<!DOCTYPE html>
<html lang="uz">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <title>Reja va Maqsadlar</title>
    
    <style>
      body {
        font-family: 'Inter', sans-serif;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #f8fafc;
        min-height: 100vh;
        display: flex;
        align-items: center;
      }
      
      .main-card {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      }

      .title-gradient {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 700;
        letter-spacing: -0.5px;
      }

      .custom-input {
        background: rgba(15, 23, 42, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #f8fafc !important;
        border-radius: 14px !important;
        padding: 0.8rem 1.2rem !important;
        transition: all 0.3s ease;
      }

      .custom-input:focus {
        border-color: #38bdf8 !important;
        box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15) !important;
      }

      .btn-add {
        background: linear-gradient(135deg, #0284c7 0%, #4f46e5 100%);
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 14px !important;
        padding: 0.8rem 1.5rem;
        transition: all 0.3s ease;
      }

      .btn-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(79, 70, 229, 0.4);
      }

      .plan-item {
        background: rgba(15, 23, 42, 0.4) !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: #f1f5f9 !important;
        border-radius: 14px !important;
        margin-bottom: 0.75rem;
        padding: 1rem 1.25rem;
        transition: all 0.2s ease;
      }

      .plan-item:hover {
        background: rgba(15, 23, 42, 0.7) !important;
        border-color: rgba(255, 255, 255, 0.15) !important;
        transform: scale(1.01);
      }

      .btn-custom-edit {
        background-color: rgba(148, 163, 184, 0.15);
        color: #cbd5e1;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 0.4rem 0.9rem;
        font-weight: 500;
        transition: all 0.2s;
      }

      .btn-custom-edit:hover {
        background-color: #38bdf8;
        color: #0f172a;
        border-color: #38bdf8;
      }

      .btn-custom-delete {
        background-color: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: 10px;
        padding: 0.4rem 0.9rem;
        font-weight: 500;
        transition: all 0.2s;
      }

      .btn-custom-delete:hover {
        background-color: #ef4444;
        color: #fff;
        border-color: #ef4444;
      }

      .btn-clear-all {
        background: rgba(239, 68, 68, 0.1);
        color: #f87171;
        border: 1px dashed rgba(239, 68, 68, 0.4);
        border-radius: 14px !important;
        padding: 0.75rem;
        font-weight: 600;
        width: 100%;
        transition: all 0.3s ease;
      }

      .btn-clear-all:hover {
        background: #ef4444;
        color: #fff;
        border-style: solid;
        box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);
      }
    </style>
  </head>
  <body>
    <div class="container my-5" style="max-width: 680px;">
      <div class="main-card">
        <h1 class="display-6 text-center mb-4 title-gradient">REJA VA MAQSADLAR</h1>

        <div class="mb-4">
          <form id="create-form" action="/create-item" method="POST">
            <div class="d-flex align-items-center gap-2">
              <input
                id="create-field"
                name="reja"
                autofocus
                autocomplete="off"
                class="form-control custom-input"
                type="text"
                placeholder="Yangi reja kiriting..."
                style="flex: 1"
              />
              <button class="btn btn-add">
                Qo'shish
              </button>
            </div>
          </form>
        </div>

        <ul id="item-list" class="list-group mb-4">
          <% items.map(function(item){ %>
             <li class="list-group-item plan-item d-flex align-items-center justify-content-between">
              <span class="item-text me-3"><%=item.reja%></span>
              <div class="d-flex gap-2">
                  <button data-id="<%=item._id%>" 
                    class="edit-me btn btn-sm btn-custom-edit">O'zgartirish</button>
                  <button data-id="<%=item._id%>" class="delete-me btn btn-sm btn-custom-delete">O'chirish</button>
              </div>
            </li>
          <% }) %>
        </ul>

        <button id="clean-all" class="btn btn-clear-all">
          Hamma Rejalarni O'chirish
        </button>
      </div>
    </div>

    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script type="module" src="/browser.js"></script>
  </body>
</html>